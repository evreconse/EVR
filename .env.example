EVRECONSE_EXCHANGE__API_SECRET=***REMOVED***
EVRECONSE_EXCHANGE_API_KEY=***REMOVED***
EVRECONSE_EXCHANGE_API_SECRET=***REMOVED***

# Telegram credentials
EVRECONSE_NOTIFICATION__TELEGRAM__BOT_TOKEN=***REMOVED***
