# Exchange (BingX) credentials - both formats for compatibility
EVRECONSE_EXCHANGE__API_KEY=your_bingx_api_key_here
EVRECONSE_EXCHANGE__API_SECRET=your_bingx_api_secret_here
EVRECONSE_EXCHANGE_API_KEY=your_bingx_api_key_here
EVRECONSE_EXCHANGE_API_SECRET=your_bingx_api_secret_here

# Telegram credentials
EVRECONSE_NOTIFICATION__TELEGRAM__BOT_TOKEN=your_telegram_bot_token_here
EVRECONSE_NOTIFICATION__TELEGRAM__CHAT_ID=your_telegram_chat_id_here

# Optional: CoinGlass API
EVRECONSE_COINGLASS_API_KEY=your_coinglass_api_key_here

# CoinMarketCap API
EVRECONSE_CMC_API_KEY=your_cmc_api_key_here

# Optional: System overrides
# EVRECONSE_SYSTEM__LOG_LEVEL=INFO
# EVRECONSE_SYSTEM__TIMEZONE=UTC
# EVRECONSE_STORAGE__DATA_PATH=./data
# EVRECONSE_SYSTEM__LOG_PATH=./logs/evreconse.log