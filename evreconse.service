[Unit]
Description=EVRECONSE LW-001 Realtime Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=evreconse
Group=evreconse
WorkingDirectory=/home/evreconse
ExecStart=/usr/bin/python3 realtime_lw001_monitor.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=EVRECONSE_EXCHANGE__API_KEY=***REMOVED***
Environment=EVRECONSE_EXCHANGE__API_SECRET=***REMOVED***
Environment=EVRECONSE_EXCHANGE_API_KEY=***REMOVED***
Environment=EVRECONSE_EXCHANGE_API_SECRET=***REMOVED***
Environment=EVRECONSE_NOTIFICATION__TELEGRAM__BOT_TOKEN=***REMOVED***
Environment=EVRECONSE_NOTIFICATION__TELEGRAM__CHAT_ID=***REMOVED***
Environment=EVRECONSE_COINGLASS_API_KEY=***REMOVED***
Environment=EVRECONSE_SYSTEM__LOG_LEVEL=INFO
Environment=EVRECONSE_SYSTEM__TIMEZONE=UTC
Environment=EVRECONSE_STORAGE__DATA_PATH=./data
Environment=EVRECONSE_SYSTEM__LOG_PATH=./logs/evreconse.log

[Install]
WantedBy=multi-user.target