[Unit]
Description=EVRECONSE LW-001 Realtime Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=evreconse
Group=evreconse
WorkingDirectory=/home/evreconse
ExecStart=/usr/bin/python3 realtime_lw001_monitor.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
# Secrets are intentionally not stored in this unit file.
# Provide them via a root-readable environment file, for example:
#   install -m 600 /dev/null /etc/evreconse/evreconse.env
#   $EDITOR /etc/evreconse/evreconse.env
EnvironmentFile=-/etc/evreconse/evreconse.env
Environment=EVRECONSE_SYSTEM__LOG_LEVEL=INFO
Environment=EVRECONSE_SYSTEM__TIMEZONE=UTC
Environment=EVRECONSE_STORAGE__DATA_PATH=./data
Environment=EVRECONSE_SYSTEM__LOG_PATH=./logs/evreconse.log

[Install]
WantedBy=multi-user.target
